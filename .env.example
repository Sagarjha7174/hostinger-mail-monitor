# Supabase -> Project -> Connect -> ORMs -> Prisma. URL-encode special chars in the password.
# Runtime: transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# Migrations + sync advisory lock: session pooler (port 5432). Must NOT be the 6543 transaction pooler.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Hostinger API (hPanel -> Profile -> API). Never expose to the browser.
HOSTINGER_API_TOKEN=
# Mail order (resource) ID that owns your mailboxes
HOSTINGER_ORDER_ID=
HOSTINGER_API_BASE_URL=https://developers.hostinger.com

# Worker
SYNC_CRON=*/2 * * * *
BACKFILL_DAYS=30

# Single-user auth
ADMIN_EMAIL=
# argon2id hash; generate with: npm run hash-password -- 'your-password'
ADMIN_PASSWORD_HASH=
# >= 32 random chars, e.g. `openssl rand -base64 48`
SESSION_SECRET=
APP_BASE_URL=http://localhost:3000
